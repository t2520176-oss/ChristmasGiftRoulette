# Supabase Project Settings -> API. Public project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Use the project's service_role key; never add NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Run npm run vapid locally, then copy the generated pair into your environment.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server only. Keep this secret and keep the pair stable across deployments.
VAPID_PRIVATE_KEY=
# Set mailto: followed by your real administrator email address.
VAPID_SUBJECT=

# Exact application origin: http://localhost:3000 for local development,
# or the HTTPS Vercel/custom domain in production. No trailing slash/path.
NEXT_PUBLIC_SITE_URL=
