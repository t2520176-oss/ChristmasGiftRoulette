# Copy to .env and fill in. NEVER commit the real .env file.

# Shared secret between the desktop app and this worker (use a long random string)
WORKER_API_KEY=change-me-to-a-long-random-string

# Engine: trellis (MIT) | hunyuan3d (check license/territory!) | mock (no GPU, protocol test only)
ENGINE=trellis

HOST=0.0.0.0
PORT=8000

# --- cost saving ---
# Allow the desktop app to stop this server/pod via POST /v1/shutdown
ALLOW_SHUTDOWN=1
# Stop automatically after N idle minutes (0 = never). Strongly recommended on paid GPUs, e.g. 10
IDLE_SHUTDOWN_MIN=10
# For RunPod *pods*: lets the worker stop its own pod (RunPod sets RUNPOD_POD_ID itself)
RUNPOD_POD_ID=
RUNPOD_API_KEY=

# --- models ---
T2I_MODEL=stabilityai/stable-diffusion-xl-base-1.0
TRELLIS_MODEL=JeffreyXiang/TRELLIS-image-large
HUNYUAN_MODEL=tencent/Hunyuan3D-2
HF_TOKEN=
TEXTURE_SIZE=1024
MESH_SIMPLIFY=0.95

# --- optional S3 upload for results > 15 MB (RunPod serverless) ---
S3_BUCKET=
S3_ENDPOINT_URL=
