{
  "name": "ourchat-cloudflare",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "node scripts/check-deploy.mjs --provisioned && wrangler deploy && wrangler d1 migrations apply DB --remote",
    "check:template": "node scripts/check-deploy.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "check": "tsc --noEmit && node --check public/app.js && node --check public/sw.js",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.5",
    "@cloudflare/workers-types": "5.20261019.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.2"
  }
}
